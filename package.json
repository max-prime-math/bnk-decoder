{
  "name": "bnk-decoder-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w bnk-decoder",
    "build": "npm run build -w @bnk-decoder/core && npm run build -w @bnk-decoder/question-model && npm run build -w bnk-decoder",
    "check": "npm run check -w @bnk-decoder/core && npm run check -w @bnk-decoder/question-model && npm run check -w bnk-decoder",
    "build:app": "npm run build -w bnk-decoder",
    "check:app": "npm run check -w bnk-decoder",
    "inspect:corpus": "node scripts/inspect-corpus.mjs",
    "inspect:records": "node scripts/inspect-records.mjs",
    "decode:file": "node --experimental-strip-types scripts/decode-file.mjs",
    "report:quality": "node scripts/report-decode-quality.mjs",
    "evaluate:rtf": "node --experimental-strip-types scripts/evaluate-rtf.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
